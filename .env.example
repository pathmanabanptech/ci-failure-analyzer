# Copy to .env (gitignored) and load with:  set -a; source .env; set +a

# Model provider: ollama | bedrock | anthropic | vertex
MODEL_PROVIDER=ollama
# Exact versions. Ollama: name:tag, optionally @<digest prefix> from `ollama list`.
TRIAGE_MODEL_ID=qwen2.5:7b-instruct@845dbda0ea48
SPECIALIST_MODEL_ID=qwen2.5:7b-instruct@845dbda0ea48
MODEL_TIMEOUT_S=120
# MODEL_MAX_OUTPUT_TOKENS=4096   (default 16000 for anthropic/vertex: thinking counts toward it)
# Per-diagnosis budget (defaults: 120 s, 8 tool calls, 60k input tokens)
# BUDGET_TIMEOUT_S=120
# BUDGET_MAX_TOOL_CALLS=8
# BUDGET_MAX_INPUT_TOKENS=60000

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=16384

# Bedrock (credentials from the usual AWS chain: AWS_PROFILE, SSO, env keys)
# AWS_REGION=us-east-1

# Anthropic (needs: uv sync --extra anthropic)
# ANTHROPIC_API_KEY=

# Claude on Google Cloud Vertex AI (needs: uv sync --extra vertex; enable the models in
# Vertex AI Model Garden; auth: gcloud auth application-default login, no API key)
# MODEL_PROVIDER=vertex
# SPECIALIST_MODEL_ID=claude-opus-5-5
# VERTEX_PROJECT_ID=your-gcp-project
# VERTEX_REGION=global
# MODEL_TIMEOUT_S=300
# BUDGET_TIMEOUT_S=600
# LLM judge for `make eval ARGS="--judge"` (a different model from the one evaluated)
# JUDGE_MODEL_PROVIDER=vertex
# JUDGE_MODEL_ID=claude-sonnet-5-5

# Cloud providers: USD per million tokens, for cost accounting
# MODEL_PRICE_INPUT_PER_MTOK=
# MODEL_PRICE_OUTPUT_PER_MTOK=

# Local clone of petclinic-ci-failures with all branches fetched
# PETCLINIC_REPO_PATH=~/path/to/petclinic-ci-failures
