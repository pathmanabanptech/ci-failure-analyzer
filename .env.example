# Copy to .env (gitignored) and load with:  set -a; source .env; set +a

# Model provider: ollama | bedrock | anthropic
MODEL_PROVIDER=ollama
# Exact versions. Ollama: name:tag, optionally @<digest prefix> from `ollama list`.
TRIAGE_MODEL_ID=qwen2.5:7b-instruct@845dbda0ea48
SPECIALIST_MODEL_ID=qwen2.5:7b-instruct@845dbda0ea48
MODEL_TIMEOUT_S=120

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=16384

# Bedrock (credentials from the usual AWS chain: AWS_PROFILE, SSO, env keys)
# AWS_REGION=us-east-1

# Anthropic (needs: uv sync --extra anthropic)
# ANTHROPIC_API_KEY=

# Cloud providers: USD per million tokens, for cost accounting
# MODEL_PRICE_INPUT_PER_MTOK=
# MODEL_PRICE_OUTPUT_PER_MTOK=

# Local clone of petclinic-ci-failures with all branches fetched
# PETCLINIC_REPO_PATH=~/path/to/petclinic-ci-failures
